# Password del AP LOADOUT (min 8 chars):
wifi_pass=%s

# Tu WiFi de casa (internet / OTA):
wifi_sta_ssid=%s
wifi_sta_pass=%s

# Tema: 0=Default 1=Solarized Dark 2=Solarized Light 3=Amber Mono
theme=%d

# Zona horaria (POSIX) para NTP. Espana: CET-1CEST,M3.5.0,M10.5.0/3
tz=UTC0

# OTA: URL del manifest latest.json de tu repo GitHub
# ota_url=https://github.com/USER/REPO/releases/latest/download/latest.json
ota_url=%s

# Atajo SDR (tile ORCSDR del inicio): nombre del .bin de OrcSDR en la SD
sdr_bin=orcsdr.bin

# Chatbot IA (endpoint OpenAI-compatible: DeepSeek/Qwen/OpenAI/Groq/Ollama)
# ai_url=https://api.deepseek.com/chat/completions
# ai_key=sk-...
# ai_model=deepseek-chat
ai_url=
ai_key=
ai_model=deepseek-chat
# Tokens: max por respuesta, presupuesto total (0 = sin limite;
# RESET en el chat lo pone a cero) y aviso de conversacion larga.
ai_max_tokens=1024
ai_budget=0
ai_ctx_warn=8000
# Solo claves Anthropic personales sin workspace fijo: wrkspc_...
ai_workspace=

# PIN de bloqueo (4-8 digitos). Vacio o 'pin=clear' = sin bloqueo.
# (recuperacion: si te bloqueas, pon pin=clear y reinicia)
pin=
